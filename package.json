{
  "name": "shipguard",
  "version": "1.0.0",
  "description": "ShipGuard is a native Atlassian Forge app for Codegeist 2026.",
  "main": "backend/index.js",
  "scripts": {
    "test": "jest --verbose",
    "lint": "forge lint"
  },
  "dependencies": {},
  "devDependencies": {
    "@forge/api": "^6.1.1",
    "@forge/ui": "^6.1.1",
    "@forge/bridge": "^5.5.0",
    "jest": "^30.5.2",
    "@types/jest": "^30.0.0",
    "@forge/cli": "^6.0.0"
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "moduleNameMapper": {
      "^@forge/api$": "<rootDir>/node_modules/@forge/api",
      "^@forge/ui$": "<rootDir>/node_modules/@forge/ui",
      "^@forge/bridge$": "<rootDir>/node_modules/@forge/bridge"
    }
  }
}